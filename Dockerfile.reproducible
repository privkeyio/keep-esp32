# frost_tr (components/frost_tr) is Rust; Espressif's toolchain builds it for
# the ESP32-S3 and the IDF stage below links the archive.
FROM espressif/idf-rust:esp32s3_1.95.0.0@sha256:ee04f9c2bd68543b73ffcccb34c44c328fcadaa2ce3eaf99c17b06671372793a AS frost_tr

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# The image's toolchains belong to its esp user; build in a directory it owns.
RUN mkdir -p /home/esp/work
WORKDIR /home/esp/work
COPY --chown=esp:esp scripts/build-frost-tr.sh scripts/build-frost-tr.sh
COPY --chown=esp:esp components/frost_tr/rust components/frost_tr/rust
RUN FROST_TR_TARGET_DIR=/tmp/frost_tr-target bash scripts/build-frost-tr.sh

FROM espressif/idf:v5.4.4@sha256:9ce51d4ace496845678065dc86f8e55fb9c25fc9f01f45597042afa7ed546926 AS builder

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV IDF_CCACHE_ENABLE=0
ENV IDF_PATH=/opt/esp/idf
ENV IDF_PATH_FORCE=1

WORKDIR /build

COPY . keep-esp32/
COPY --from=frost_tr /home/esp/work/components/frost_tr/lib/libfrost_tr.a keep-esp32/components/frost_tr/lib/libfrost_tr.a

RUN for repo in \
        "privkeyio/secp256k1-frost 746dbbea5c34dde963c9bd55bc7474b2d50fa597" \
        "privkeyio/libnostr-c e07af71f39953ce31cf19c358c4ba2a7e7025800" \
        "privkeyio/noscrypt 02e47e81eb9338d8cb9ae84a14a3992f00f4a651" \
        "ElementsProject/libwally-core 0c41f38fb1c201786e9c3ac9eae4f5f80c051399"; do \
        set -- $repo; \
        git clone "https://github.com/$1.git" && \
        git -C "$(basename $1)" checkout "$2"; \
    done

RUN . $IDF_PATH/export.sh && \
    cd keep-esp32 && \
    idf.py set-target esp32s3 && \
    idf.py build && \
    { grep -q '^#define CONFIG_KEEP_UI_TEST 1' build/config/sdkconfig.h; [ $? -eq 1 ]; } && \
    mkdir -p /out && \
    cp build/keep.bin /out/ && \
    cp build/bootloader/bootloader.bin /out/ && \
    cp build/partition_table/partition-table.bin /out/ && \
    cp build/ota_data_initial.bin /out/

RUN . $IDF_PATH/export.sh && \
    cd /out && \
    esptool.py --chip esp32s3 merge_bin \
        --flash_mode dio \
        --flash_freq 80m \
        --flash_size 8MB \
        -o keep-merged.bin \
        0x0 bootloader.bin \
        0x8000 partition-table.bin \
        0xd000 ota_data_initial.bin \
        0x10000 keep.bin && \
    sha256sum keep.bin > keep.bin.sha256 && \
    sha256sum keep-merged.bin > keep-merged.bin.sha256

FROM scratch AS export
COPY --from=builder /out/* /
